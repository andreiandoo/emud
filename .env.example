APP_NAME=eMUD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=emud
DB_USERNAME=emud
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must stay above the longest job timeout (SyncCatalogSource: 7200s), otherwise Redis
# releases a still-running import and a second worker re-imports the same source.
REDIS_QUEUE_RETRY_AFTER=7260

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STORE_CURRENCY=RON
STORE_VAT_RATE=21
DEFAULT_MARKUP_PERCENT=25
PRICE_ENDING=0.99
SUPPLIER_STALE_AFTER_MINUTES=60

# RapidAPI provider-side authentication. Keep the proxy secret private.
RAPIDAPI_PROXY_SECRET=
# Optional defense-in-depth validation, e.g. automotive-catalog.p.rapidapi.com
RAPIDAPI_EXPECTED_HOST=
RAPIDAPI_AUTO_PROVISION=true
# 0 = no local ceiling; RapidAPI remains responsible for marketplace plan enforcement/billing.
RAPIDAPI_BASIC_LOCAL_QUOTA=0
RAPIDAPI_PRO_LOCAL_QUOTA=0
RAPIDAPI_ULTRA_LOCAL_QUOTA=0
RAPIDAPI_MEGA_LOCAL_QUOTA=0
RAPIDAPI_CUSTOM_LOCAL_QUOTA=0

# National workshop registry (config/workshops.php). Every source works without a key;
# geocoding and web search stay off until configured.
WORKSHOPS_USER_AGENT="eMUD-WorkshopRegistry/1.0 (+https://a-n.ro/contact)"
RAR_IMPORT_ENABLED=true
RAR_REQUEST_DELAY_MS=2000
RAR_REQUEST_TIMEOUT=90
RAR_MAX_RETRIES=4
RAR_PAGE_SIZE=250
# Keep the downloaded ONRC files (~1.2 GB) after an import.
ONRC_KEEP_FILES=false
# osmium-tool binary for the OpenStreetMap import (apt install osmium-tool).
OSMIUM_BINARY=osmium
# null | nominatim. Point WORKSHOPS_NOMINATIM_URL at a self-hosted instance.
WORKSHOPS_GEOCODER=null
WORKSHOPS_NOMINATIM_URL=
WORKSHOPS_ALLOW_PUBLIC_NOMINATIM=false
# null | brave
WORKSHOPS_SEARCH_PROVIDER=null
BRAVE_SEARCH_API_KEY=
WORKSHOPS_CRAWL_MAX_PAGES=8
WORKSHOPS_CRAWL_DELAY_MS=1500
# Weekly RAR, monthly OSM and ONRC refresh. Off until switched on deliberately.
WORKSHOPS_SCHEDULE_ENABLED=false

# Optional: creates or updates the initial administrator on db:seed.
ADMIN_NAME="eMUD Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
